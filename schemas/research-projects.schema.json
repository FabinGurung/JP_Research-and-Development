{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^PROJ-[0-9]{6}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){2,}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "PUBLIC_MODULE_AVAILABLE",
              "DIRECTORY_ONLY"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "scientific_state": {
            "const": "NOT_ASSERTED"
          },
          "publication": {
            "const": "PUBLIC_METADATA_ONLY"
          }
        },
        "required": [
          "project_id",
          "slug",
          "label",
          "category",
          "summary",
          "route",
          "status",
          "source",
          "scientific_state",
          "publication"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "authority",
    "projects"
  ],
  "additionalProperties": false
}
