  ],
  "qa_controls": {
    "amount_math": "SUM_PERCENTS_100;SUM_AMOUNT_EQUALS_CONTRACT;EACH_RATE_TIMES_CONTRACT_EQUALS_AMOUNT_TO_CURRENCY_PRECISION",
    "trigger": "COMMENCEMENT_AND_COMPLETION_ALLOWED_ONLY_WITH_WRITTEN_EVENT_CERTIFICATION",
    "no_invented_terms": "MISSING_PAYMENT_DUE_DAYS_OR_CERTIFIER_AUTHORITY_REMAIN_EXPLICIT_HOLDS",
