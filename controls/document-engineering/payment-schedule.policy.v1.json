    "drawing_precedence": "ATTACHED_SIGNED_DRAWING_REGISTER_CONTROLS_TECHNICAL_DIMENSIONS;WRITTEN_SIGNED_SCOPE_AND_EXCLUSIONS_CONTROLS_COMMERCIAL_INCLUSION;DISCREPANCIES_REQUIRE_SIGNED_VARIATION",
