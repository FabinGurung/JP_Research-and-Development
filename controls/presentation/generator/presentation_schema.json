{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A9 Presentation Content v2.1",
  "type": "object",
  "required": [
    "metadata",
    "slides"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "researcher"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "researcher": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "client_facing": {
          "type": "boolean"
        },
        "logo": {
          "type": "string"
        },
        "logo_sha256": {
          "type": "string"
        },
        "title_logo_size_in": {
          "type": "number",
          "exclusiveMinimum": 2.0
        },
        "supervisor": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "designation": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "co_supervisors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "designation": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "supervisor_available": {
          "type": "boolean"
        },
        "co_supervisors_available": {
          "type": "boolean"
        }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "title",
              "bullets",
              "section",
              "figure",
              "two_figures",
              "closing",
              "literature_table",
              "methodology_flow"
            ]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "figure": {
            "type": "object"
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "caption": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "columns": {
            "enum": [
              3,
              4
            ]
          },
          "max_rows_per_slide": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reference_id",
                "key_finding",
                "project_relevance",
                "finding_locator",
                "relevance_basis",
                "relevance_type"
              ],
              "properties": {
                "reference_id": {
                  "type": "string"
                },
                "key_finding": {
                  "type": "string"
                },
                "project_relevance": {
                  "type": "string"
                },
                "finding_locator": {
                  "type": "string"
                },
                "relevance_basis": {
                  "type": "string"
                },
                "relevance_type": {
                  "enum": [
                    "METHOD",
                    "CONTEXT",
                    "TECHNICAL_BASIS",
                    "COMPARISON",
                    "LIMITATION",
                    "RESEARCH_GAP"
                  ]
                },
                "method_or_limitation": {
                  "type": "string"
                }
              }
            }
          },
          "layout": {
            "type": "string",
            "enum": [
              "horizontal_linear"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "left_to_right"
            ]
          },
          "max_stages_per_slide": {
            "type": "integer",
            "minimum": 3,
            "maximum": 6
          },
          "stages": {
            "type": "array",
            "minItems": 3,
            "maxItems": 24,
            "items": {
              "type": "object",
              "required": [
                "stage_id",
                "title",
                "description",
                "category",
                "output",
                "manuscript_locator",
                "evidence_refs"
              ],
              "properties": {
                "stage_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,23}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 38
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "INPUT",
                    "PREPARATION",
                    "FIELD",
                    "SCREENING",
                    "VERIFICATION",
                    "ANALYSIS",
                    "OUTPUT"
                  ]
                },
                "output": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 95
                },
                "input": {
                  "type": "string"
                },
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "manuscript_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "evidence_status": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "connectors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "literature_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference_id",
          "authors",
          "year",
          "title",
          "source_id",
          "bibliography_key",
          "source_kind"
        ],
        "properties": {
          "reference_id": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "bibliography_key": {
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "PEER_REVIEWED",
              "THESIS",
              "CODE",
              "STANDARD",
              "GUIDELINE",
              "MANUFACTURER",
              "OTHER"
            ]
          },
          "doi_or_url": {
            "type": "string"
          }
        }
      }
    }
  }
}
