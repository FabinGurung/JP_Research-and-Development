      "scope": "ALL_RESEARCHERS",
      "implementation": "REQUIRED_LATEX_AND_PDF_WITH_OPTIONAL_REQUEST_ONLY_GOOGLE_DOC__PROVIDER_READBACK_AND_RESEARCHER_RECEIPTS",
