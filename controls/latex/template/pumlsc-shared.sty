\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pumlsc-shared}[2026/10/09 v2.3 source-checked PU preliminaries, headings and appendices]
% One reusable source shared by all researchers; NEVER fork into individual manuscripts.
% PU source v1.13, full 144-rule source audit: controls/latex/pu-format-parity-audit.json.
% Format parity/production still require exact-font PDF compilation and every-page render QA.
\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{pumlsc-shared}{XeLaTeX required}{Select XeLaTeX}
\fi
\RequirePackage{geometry}
\geometry{a4paper,twoside=false,left=3cm,right=2.5cm,top=2.5cm,bottom=2.5cm}
\RequirePackage{fontspec}
% PU-FMT-004/005/129/130: exact font in production; explicit Tinos preview only.
% The preview flag is defined in the build command, never silently enabled.
\ifdefined\PUPreviewTinosFont
  \IfFontExistsTF{Tinos}{\setmainfont{Tinos}}{
    \PackageError{pumlsc-shared}{Tinos preview font not available}{Install fonts-croscore.}}
  \PackageWarningNoLine{pumlsc-shared}{Tinos fallback mode: PREVIEW ONLY; production certification forbidden}
\else
  \IfFontExistsTF{Times New Roman}{\setmainfont{Times New Roman}}{
    \PackageError{pumlsc-shared}{Exact Times New Roman unavailable}{Use licensed Times New Roman for production, or explicit controlled Tinos preview mode.}}
\fi
\RequirePackage{setspace}
\onehalfspacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\hyphenpenalty=10000
\exhyphenpenalty=10000
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\pagestyle{plain}
\raggedbottom
\RequirePackage{titlesec}
\titleformat{\chapter}[display]{\raggedright\normalfont\bfseries\fontsize{12}{14}\selectfont}{CHAPTER \thechapter}{0pt}{\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{18pt}
\titleformat{\section}{\raggedright\normalfont\bfseries\fontsize{12}{14}\selectfont}{\thesection}{1em}{}
\titlespacing*{\section}{0pt}{1.2ex}{0.6ex}
\titleformat{\subsection}{\raggedright\normalfont\bfseries\fontsize{12}{14}\selectfont}{\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{1.0ex}{0.5ex}
\RequirePackage{caption}
\captionsetup[table]{position=top,justification=raggedright,singlelinecheck=false}
\captionsetup[figure]{position=bottom,justification=centering,singlelinecheck=false}
\RequirePackage{booktabs}
\RequirePackage{hyperref}
\hypersetup{hidelinks}
\providecommand{\bibname}{REFERENCES}
\renewcommand{\bibname}{REFERENCES}
\providecommand{\refname}{REFERENCES}
\renewcommand{\refname}{REFERENCES}
\newcommand{\PUStartPreliminaries}{\pagenumbering{roman}}
\newcommand{\PUStartTitlePage}{\pagenumbering{roman}\thispagestyle{empty}}
\newcommand{\PUStartMainBody}{\clearpage\pagenumbering{arabic}}
\newcommand{\PUNarrativePrelimHeading}[1]{\par\begin{center}{\bfseries\fontsize{16}{19}\selectfont #1}\end{center}\par}
\newcommand{\PUListPrelimHeading}[1]{\par\begin{center}{\bfseries\fontsize{14}{17}\selectfont #1}\end{center}\par}
% Exact official title/approval pages, TOC/LOT/LOF layout, project metadata, logo,
% bibliography style, appendices and verified contents must be supplied from governed
% source. This package does NOT invent research facts or claim full template parity.


% Approved PU v1.13 generic source-format corrections, RD-LTX-CHG-102.
% Leave official administrative text, academic content and signatures to the researcher.
\newcommand{\PUEnableAppendixHeadings}{%
  \titleformat{\chapter}[display]{\centering\bfseries\fontsize{14}{17}\selectfont}{Appendix \thechapter:}{0pt}{\MakeUppercase}}
\makeatletter
\newcommand{\PUListOfAppendices}{\begingroup\singlespacing\PUListPrelimHeading{LIST OF APPENDICES}\@starttoc{loa}\endgroup}
\newcommand{\PUAddAppendixEntry}[1]{\addcontentsline{loa}{section}{Appendix \thechapter: #1}}
\makeatother
\renewcommand{\contentsname}{\makebox[\linewidth][c]{TABLE OF CONTENTS}}
\renewcommand{\listtablename}{\makebox[\linewidth][c]{LIST OF TABLES}}
\renewcommand{\listfigurename}{\makebox[\linewidth][c]{LIST OF FIGURES}}
\newcommand{\PUPrintContents}{\begingroup\singlespacing\tableofcontents\endgroup}
\newcommand{\PUPrintTables}{\begingroup\singlespacing\listoftables\endgroup}
\newcommand{\PUPrintFigures}{\begingroup\singlespacing\listoffigures\endgroup}
\makeatletter
\AtBeginDocument{%
  \@ifpackageloaded{tocloft}{%
    \renewcommand{\cfttoctitlefont}{\bfseries\fontsize{14}{17}\selectfont\centering}%
    \renewcommand{\cftaftertoctitle}{}%
    \renewcommand{\cftlottitlefont}{\bfseries\fontsize{14}{17}\selectfont\centering}%
    \renewcommand{\cftafterlottitle}{}%
    \renewcommand{\cftloftitlefont}{\bfseries\fontsize{14}{17}\selectfont\centering}%
    \renewcommand{\cftafterloftitle}{}%
    \setlength{\cftbeforetoctitleskip}{0pt}%
    \setlength{\cftbeforelottitleskip}{0pt}%
    \setlength{\cftbeforeloftitleskip}{0pt}%
  }{}
}
\makeatother

% RD-LTX-CHG-104: opt-in, project-configurable cover spacing helper.
% Only use after the university-approved cover geometry is checked; existing
% manuscripts are unchanged unless they call this macro deliberately.
\newcommand{\PUCoverLogoAuthorSpace}[1][30pt]{\par\vspace{#1}}
