% SEQ045: researcher-scoped List of Tables/List of Figures only; keep TOC unchanged.
% A7 scoped presentation adjustment; do not modify the shared PU style.
\AtBeginDocument{%
  \renewcommand{\listtablename}{\makebox[\textwidth][l]{LIST OF TABLES}}%
  \renewcommand{\listfigurename}{\makebox[\textwidth][l]{LIST OF FIGURES}}%
  \renewcommand{\cftlottitlefont}{\bfseries\fontsize{14}{17}\selectfont\raggedright}%
  \renewcommand{\cftloftitlefont}{\bfseries\fontsize{14}{17}\selectfont\raggedright}%
  \renewcommand{\cftafterlottitle}{\par}%
  \renewcommand{\cftafterloftitle}{\par}%
  \renewcommand{\cfttabfont}{\normalfont\fontsize{12}{17}\selectfont}%
  \renewcommand{\cftfigfont}{\normalfont\fontsize{12}{17}\selectfont}%
  \setlength{\cftbeforetabskip}{2pt}%
  \setlength{\cftbeforefigskip}{2pt}%
  \setlength{\cfttabindent}{0pt}%
  \setlength{\cftfigindent}{0pt}%
}

% SEQ045: direct, researcher-only list headings. Avoid tocloft's centred
% chapter-style heading while retaining its existing .lot/.lof entry rendering.
\makeatletter
\renewcommand{\PUPrintTables}{%
  \begingroup\singlespacing
  \noindent{\bfseries\fontsize{14}{17}\selectfont LIST OF TABLES\par}%
  \vspace{12pt}%
  \@starttoc{lot}%
  \endgroup}
\renewcommand{\PUPrintFigures}{%
  \begingroup\singlespacing
  \noindent{\bfseries\fontsize{14}{17}\selectfont LIST OF FIGURES\par}%
  \vspace{12pt}%
  \@starttoc{lof}%
  \endgroup}
\makeatother

% SEQ045 actual public call sites: the project adapter's PUListOfTables and
% PUListOfFigures (not the shared PUPrint* helpers) supply the visible headings.
% Override precisely those two; leave the appendix list and TOC headings intact.
\makeatletter
\renewcommand{\PUListOfTables}{%
  \clearpage\addcontentsline{toc}{puprelim}{List of tables}%
  \noindent{\bfseries\fontsize{14}{18}\selectfont List of tables\par}\vspace{12pt}%
  \begingroup\singlespacing\fontsize{12}{17}\selectfont\@starttoc{lot}\endgroup}
\renewcommand{\PUListOfFigures}{%
  \clearpage\addcontentsline{toc}{puprelim}{List of figures}%
  \noindent{\bfseries\fontsize{14}{18}\selectfont List of figures\par}\vspace{12pt}%
  \begingroup\singlespacing\fontsize{12}{17}\selectfont\@starttoc{lof}\endgroup}
\makeatother

% SEQ047 A7 / Saugat-specific override: user requests 1.33-inch TOP margin.
% PU FST 2019 published default remains 2.5cm top; this difference is
% intentional, researcher-only, recorded in the QA receipt; other margins untouched.
\geometry{top=1.33in}

