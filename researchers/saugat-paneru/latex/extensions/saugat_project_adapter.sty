\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{saugat_project_adapter}[2026/10/19 v0.1 Saugat CP114 metadata/semantic compatibility with R&D shared PU template]
% This is project data/rendering glue ONLY; generic page geometry, fonts, headings
% and captions are owned by the central pumlsc-shared.sty package.
\RequirePackage{graphicx}
\RequirePackage{array,tabularx,longtable}
\RequirePackage{amsmath,amssymb}
\RequirePackage{tocloft}
\RequirePackage{etoolbox}
\RequirePackage{ragged2e}
\RequirePackage{needspace}
\RequirePackage{microtype}
\RequirePackage{chngcntr}
\RequirePackage{csquotes}
\RequirePackage{xcolor}
\RequirePackage{newfloat}
\RequirePackage{hyphenat}
\RequirePackage[backend=biber,style=ieee,sorting=none]{biblatex}
\addbibresource{references.bib}
\defbibheading{pubibliography}{\chapter*{REFERENCES}\addcontentsline{toc}{chapter}{REFERENCES}}
\setcounter{secnumdepth}{3}\setcounter{tocdepth}{3}
% Local, source-verified student and supervisor metadata is in project_config.tex.
\newcommand{\PULogo}{\includegraphics[width=1.6in,height=1.6in,keepaspectratio]{\PULogoFile}}
\newcommand{\PURegistrationLine}{\par{\fontsize{12}{18}\selectfont (\PURegistrationNumber)}\par\vspace{14pt}}
\newcommand{\PUCoverPage}{%
\thispagestyle{empty}\begin{center}
{\fontsize{16}{20}\selectfont Thesis for the Degree of \PUDegreeName\par}\vspace{14pt}
{\bfseries\fontsize{20}{24}\selectfont \PUThesisTitle\par}\vspace{30pt}
\PULogo\par\vfill
{\bfseries\fontsize{16}{20}\selectfont \PUStudentName\par}
\PURegistrationLine
{\bfseries\fontsize{16}{20}\selectfont \PUSchool\par\PUFaculty\par\PUUniversity, \PUUniversityLocation\par}\vspace{14pt}
{\bfseries\fontsize{16}{20}\selectfont \PUSubmissionDate\par}
\end{center}}
% The approved CP114 title-page override lives in main.tex, sourced unchanged.
\providecommand{\PUTitlePage}{}
\newcommand{\PUDeclarationPage}{\clearpage\addcontentsline{toc}{chapter}{Declaration}\PUNarrativePrelimHeading{Declaration}\input{frontmatter/declaration.tex}}
\newcommand{\PURecommendationPage}{\clearpage\addcontentsline{toc}{chapter}{Recommendation}\PUNarrativePrelimHeading{Recommendation}\input{frontmatter/recommendation.tex}}
\newcommand{\PUCertificatePage}{\clearpage\addcontentsline{toc}{chapter}{Certificate}\PUNarrativePrelimHeading{Certificate}\input{frontmatter/certificate.tex}}
\newcommand{\PUAcknowledgementsPage}{\clearpage\addcontentsline{toc}{chapter}{Acknowledgements}\PUNarrativePrelimHeading{Acknowledgements}\input{frontmatter/acknowledgements.tex}}
\newlength{\PUAbstractIndent}
\settowidth{\PUAbstractIndent}{\space\space\space\space}
\newcommand{\PUAbstractParagraph}[1]{\noindent\hspace*{\PUAbstractIndent}#1\par}
\newcommand{\PUAbstractPage}{\clearpage\addcontentsline{toc}{chapter}{Abstract}\PUNarrativePrelimHeading{ABSTRACT}\begingroup\justifying\input{frontmatter/abstract.tex}\vspace{\baselineskip}\noindent\textbf{Keywords:} \input{frontmatter/keywords.tex}\endgroup}
\newcommand{\PUTableOfContents}{\clearpage\addcontentsline{toc}{chapter}{Table of contents}\PUPrintContents}
\newcommand{\PUListOfTables}{\clearpage\addcontentsline{toc}{chapter}{List of tables}\PUPrintTables}
\newcommand{\PUListOfFigures}{\clearpage\addcontentsline{toc}{chapter}{List of figures}\PUPrintFigures}
\makeatletter
\newcommand{\PUListOfPlates}{\clearpage\addcontentsline{toc}{chapter}{List of plates/pictures}\begingroup\singlespacing\PUNarrativePrelimHeading{List of plates/pictures}\@starttoc{lop}\endgroup}
\makeatother
\newcounter{puappendix}
\renewcommand{\thepuappendix}{\arabic{puappendix}}
\newcommand{\PUAppendix}[1]{\clearpage\stepcounter{puappendix}\addcontentsline{loa}{saugatappendix}{Appendix \thepuappendix. #1}\addcontentsline{toc}{chapter}{Appendix \thepuappendix: #1}\begin{center}\bfseries\fontsize{14}{18}\selectfont Appendix \thepuappendix: #1\end{center}\vspace{24pt}}
\newenvironment{PUAbbreviations}{\clearpage\addcontentsline{toc}{chapter}{Abbreviations/Acronyms}\PUListPrelimHeading{Abbreviations/Acronyms}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\begin{tabular}{@{}p{2.5cm}p{\dimexpr\textwidth-2.5cm-2\tabcolsep\relax}@{}}}{\end{tabular}\endgroup}
\newenvironment{PUUnits}{\clearpage\addcontentsline{toc}{chapter}{Units and Conversions}\PUListPrelimHeading{Units and Conversions}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\begin{tabular}{@{}p{2.5cm}p{\dimexpr\textwidth-2.5cm-2\tabcolsep\relax}@{}}}{\end{tabular}\endgroup}
\newcommand{\PUTableCompact}{\fontsize{10}{12}\selectfont}
\newcommand{\PUTableNormal}{\fontsize{12}{14.4}\selectfont}
\newcommand{\PUCaptionSource}[1]{\ifstrempty{#1}{}{\space[Source: #1]}}
\counterwithout{equation}{chapter}\renewcommand{\theequation}{\arabic{equation}}
\newcommand{\pueqref}[1]{Eq.~(\ref{#1})}\newcommand{\pufigref}[1]{Fig.~\ref{#1}}\newcommand{\putabref}[1]{Table~\ref{#1}}
\renewcommand{\figurename}{Fig.}
\captionsetup[table]{labelsep=period}
\captionsetup[figure]{labelsep=space}
\makeatletter\@ifundefined{cftfigpresnum}{}{\renewcommand{\cftfigpresnum}{Fig.\ }}\makeatother
% A narrowly scoped CP114 paragraph-wrap exception carried from the verified
% source metadata. Shared headings, page geometry, font and captions remain
% authoritative; this prevents the shared-template hyphenation defaults from
% pushing existing approved wording beyond PU margins.
\pretolerance=500
\tolerance=1800
\hyphenpenalty=500
\exhyphenpenalty=50
\emergencystretch=3em
% Figure/table numbering widths from verified CP114 List of Figures/Tables.
\renewcommand{\cftfigpresnum}{Fig.\ }
\setlength{\cftfignumwidth}{6.5em}
\renewcommand{\cfttabpresnum}{Table\ }
\setlength{\cfttabnumwidth}{6.5em}


% CP114 front-matter parity override: narrow, researcher-specific legacy list
% presentation. The shared PU engine continues to own geometry, font, body,
% chapter headings, and general format defaults. Ref: CP114 official 115p.
\renewcommand{\cftdotsep}{1.5}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftchapfont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftchappagefont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftsecfont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftsecpagefont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftsubsecfont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftsubsecpagefont}{\normalfont\fontsize{12}{14.4}\selectfont}
\setlength{\cftbeforechapskip}{4pt}
\setlength{\cftbeforesecskip}{0pt}
\cftsetrmarg{6.5em}
\cftsetpnumwidth{3.8em}
\setlength{\cftfignumwidth}{4.8em}
\setlength{\cfttabnumwidth}{5.4em}
\newcommand{\SaugatCPListTitle}[1]{\begin{center}\bfseries\fontsize{14}{18}\selectfont #1\end{center}\vspace{12pt}}
\makeatletter
\newcommand{\l@saugatappendix}{\@dottedtocline{0}{0em}{7em}}
\renewcommand{\PUTableOfContents}{\clearpage\addcontentsline{toc}{chapter}{Table of contents}\SaugatCPListTitle{Table of contents}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\@starttoc{toc}\endgroup}
\renewcommand{\PUListOfTables}{\clearpage\addcontentsline{toc}{chapter}{List of tables}\SaugatCPListTitle{List of tables}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\@starttoc{lot}\endgroup}
\renewcommand{\PUListOfFigures}{\clearpage\addcontentsline{toc}{chapter}{List of figures}\SaugatCPListTitle{List of figures}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\@starttoc{lof}\endgroup}
\renewcommand{\PUListOfAppendices}{\clearpage\addcontentsline{toc}{chapter}{List of appendices}\SaugatCPListTitle{List of appendices}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\@starttoc{loa}\endgroup}
\makeatother
