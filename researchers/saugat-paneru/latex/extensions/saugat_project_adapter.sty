  \renewcommand{\cftsecfont}{\normalfont\fontsize{12}{17}\selectfont}%
  \renewcommand{\cftsecpagefont}{\normalfont\fontsize{12}{17}\selectfont}%
  \renewcommand{\cftsubsecfont}{\normalfont\fontsize{12}{17}\selectfont}%
  \renewcommand{\cftsubsecpagefont}{\normalfont\fontsize{12}{17}\selectfont}%
  \renewcommand{\cftsubsubsecfont}{\normalfont\fontsize{12}{17}\selectfont}%
  \renewcommand{\cftsubsubsecpagefont}{\normalfont\fontsize{12}{17}\selectfont}%
  \setlength{\cftbeforechapskip}{2pt}%
  \setlength{\cftbeforesecskip}{2pt}%
  \setlength{\cftbeforesubsecskip}{2pt}%
  \setlength{\cftbeforesubsubsecskip}{2pt}%
  \renewcommand*{\l@puprelim}[2]{%
