\renewcommand{\cftchapfont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftchappagefont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftsecfont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftsecpagefont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftsubsecfont}{\normalfont\fontsize{12}{14.4}\selectfont}
\renewcommand{\cftsubsecpagefont}{\normalfont\fontsize{12}{14.4}\selectfont}
\setlength{\cftbeforechapskip}{4pt}
\setlength{\cftbeforesecskip}{0pt}
\cftsetrmarg{6.5em}
\cftsetpnumwidth{3.8em}
\setlength{\cftfignumwidth}{4.8em}
\setlength{\cfttabnumwidth}{5.4em}
\newcommand{\SaugatCPListTitle}[1]{\begin{center}\bfseries\fontsize{14}{18}\selectfont #1\end{center}\vspace{12pt}}
\makeatletter
\newcommand{\l@saugatappendix}{\@dottedtocline{0}{0em}{7em}}
\renewcommand{\PUTableOfContents}{\clearpage\addcontentsline{toc}{puprelim}{Table of contents}\PUPrintContents}
\renewcommand{\PUListOfTables}{\clearpage\addcontentsline{toc}{puprelim}{List of tables}\SaugatCPListTitle{List of tables}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\@starttoc{lot}\endgroup}
\renewcommand{\PUListOfFigures}{\clearpage\addcontentsline{toc}{puprelim}{List of figures}\SaugatCPListTitle{List of figures}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\@starttoc{lof}\endgroup}
\renewcommand{\PUListOfAppendices}{\clearpage\addcontentsline{toc}{puprelim}{List of appendices}\SaugatCPListTitle{List of appendices}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\@starttoc{loa}\endgroup}
