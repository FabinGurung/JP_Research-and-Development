\RequirePackage{tocloft}
% SEQ042: preliminary entries retain Roman page numbers while chapter header rows remain dotless.
\makeatletter
\newcommand*{\l@puprelim}[2]{%
  \addpenalty{-\@highpenalty}\vskip\cftbeforechapskip
  \noindent\parbox{\linewidth}{\normalfont\fontsize{12}{14.4}\selectfont #1\hfill\normalfont\fontsize{12}{14.4}\selectfont #2}\par
}
\makeatother
