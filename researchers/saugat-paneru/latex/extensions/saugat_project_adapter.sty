\addbibresource{references.bib}
\defbibheading{pubibliography}{\chapter*{REFERENCES}\addcontentsline{toc}{chapter}{REFERENCES}}
\setcounter{secnumdepth}{3}\setcounter{tocdepth}{3}
% Local, source-verified student and supervisor metadata is in project_config.tex.
% University logo size comes from the shared PU template; image stays local.
\newcommand{\PULogo}{\PUScaledCoverLogo{\PULogoFile}}
% SEQ048 A7 000030: remove only the 14pt registration-to-school blank gap on
% the two title pages; the existing type treatment and text are unchanged.
\newcommand{\PURegistrationLine}{\par{\bfseries\fontsize{12}{18}\selectfont \PURegistrationNumber}\par}
\newcommand{\PUCoverPage}{%
\thispagestyle{empty}\begin{center}
{\fontsize{16}{20}\selectfont Thesis for the Degree of \PUDegreeName\par}\vspace{14pt}
{\bfseries\fontsize{20}{24}\selectfont \PUThesisTitle\par}\vspace{30pt}
\PULogo\par\vfill\vspace*{60pt}
{\bfseries\fontsize{16}{20}\selectfont \PUStudentName\par}
\PURegistrationLine
% SEQ049 A7 000031: fixed 28pt above and below university block; date at foot.
\vspace*{28pt}
{\bfseries\fontsize{16}{20}\selectfont \PUSchool\par\PUFaculty\par\PUUniversity, \PUUniversityLocation\par}
\vspace*{28pt}
\vfill
{\bfseries\fontsize{16}{20}\selectfont \PUSubmissionDate\par}
\end{center}}
% The approved CP114 title-page override lives in main.tex, sourced unchanged.
\providecommand{\PUTitlePage}{}
% SEQ050 / A7 000032: two requested 14pt vertical spaces above only the
% four named preliminary headings. At a page top, \vspace* injects an
% additional 30.77pt via this legacy center-heading start sequence.
% Compensate it so the MEASURED heading displacement is 28.12pt, not 58.77pt.
% This is Saugat-only; central PU style, page geometry, body unchanged.
\newcommand{\SaugatPrelimTopSpacing}{\vspace*{14pt}\vspace*{14pt}\vspace*{-30.77pt}}
\newcommand{\PUDeclarationPage}{\clearpage\addcontentsline{toc}{puprelim}{Declaration}\SaugatPrelimTopSpacing\PUNarrativePrelimHeading{Declaration}\input{frontmatter/declaration.tex}}
\newcommand{\PURecommendationPage}{\clearpage\addcontentsline{toc}{puprelim}{Recommendation}\SaugatPrelimTopSpacing\PUNarrativePrelimHeading{Recommendation}\input{frontmatter/recommendation.tex}}
\newcommand{\PUCertificatePage}{\clearpage\addcontentsline{toc}{puprelim}{Certificate}\SaugatPrelimTopSpacing\PUNarrativePrelimHeading{Certificate}\input{frontmatter/certificate.tex}}
\newcommand{\PUAcknowledgementsPage}{\clearpage\addcontentsline{toc}{puprelim}{Acknowledgements}\SaugatPrelimTopSpacing\PUNarrativePrelimHeading{Acknowledgements}\input{frontmatter/acknowledgements.tex}}
\newlength{\PUAbstractIndent}
\settowidth{\PUAbstractIndent}{\space\space\space\space}
\newcommand{\PUAbstractParagraph}[1]{\noindent\hspace*{\PUAbstractIndent}#1\par}
\newcommand{\PUAbstractPage}{\clearpage\addcontentsline{toc}{puprelim}{Abstract}\PUNarrativePrelimHeading{ABSTRACT}\enlargethispage{2\baselineskip}\begingroup\begin{spacing}{1.10}\justifying\input{frontmatter/abstract.tex}\vspace{0.2\baselineskip}\noindent\textbf{Keywords:} \input{frontmatter/keywords.tex}\end{spacing}\endgroup}
\newcommand{\PUTableOfContents}{\clearpage\addcontentsline{toc}{puprelim}{Table of contents}\PUPrintContents}
\newcommand{\PUListOfTables}{\clearpage\addcontentsline{toc}{puprelim}{List of tables}\PUPrintTables}
\newcommand{\PUListOfFigures}{\clearpage\addcontentsline{toc}{puprelim}{List of figures}\PUPrintFigures}
\makeatletter
\newcommand{\PUListOfPlates}{\clearpage\addcontentsline{toc}{chapter}{List of plates/pictures}\begingroup\singlespacing\PUNarrativePrelimHeading{List of plates/pictures}\@starttoc{lop}\endgroup}
\makeatother
\newcounter{puappendix}
\renewcommand{\thepuappendix}{\arabic{puappendix}}
\newcommand{\PUAppendix}[1]{\clearpage\stepcounter{puappendix}\addcontentsline{loa}{saugatappendix}{Appendix \thepuappendix. #1}\addcontentsline{toc}{chapter}{Appendix \thepuappendix: #1}\begin{center}\bfseries\fontsize{14}{18}\selectfont Appendix \thepuappendix: #1\end{center}\vspace{24pt}}
\newenvironment{PUAbbreviations}{\clearpage\addcontentsline{toc}{puprelim}{Abbreviations/Acronyms}\PUListPrelimHeading{Abbreviations/Acronyms}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\begin{tabular}{@{}p{2.5cm}p{\dimexpr\textwidth-2.5cm-2\tabcolsep\relax}@{}}}{\end{tabular}\endgroup}
\newenvironment{PUUnits}{\clearpage\addcontentsline{toc}{puprelim}{Units and Conversions}\PUListPrelimHeading{Units and Conversions}\begingroup\singlespacing\fontsize{12}{14.4}\selectfont\begin{tabular}{@{}p{2.5cm}p{\dimexpr\textwidth-2.5cm-2\tabcolsep\relax}@{}}}{\end{tabular}\endgroup}
\newcommand{\PUTableCompact}{\fontsize{10}{12}\selectfont}
\newcommand{\PUTableNormal}{\fontsize{12}{14.4}\selectfont}
\newcommand{\PUCaptionSource}[1]{\ifstrempty{#1}{}{\space[Source: #1]}}
\counterwithout{equation}{chapter}\renewcommand{\theequation}{\arabic{equation}}
\newcommand{\pueqref}[1]{Eq.~(\ref{#1})}\newcommand{\pufigref}[1]{Fig.~\ref{#1}}\newcommand{\putabref}[1]{Table~\ref{#1}}
\renewcommand{\figurename}{Fig.}
\captionsetup[table]{labelsep=period}
\captionsetup[figure]{labelsep=space}
\makeatletter\@ifundefined{cftfigpresnum}{}{\renewcommand{\cftfigpresnum}{Fig.\ }}\makeatother
% A narrowly scoped CP114 paragraph-wrap exception carried from the verified
% source metadata. Shared headings, page geometry, font and captions remain
% authoritative; this prevents the shared-template hyphenation defaults from
% pushing existing approved wording beyond PU margins.
\pretolerance=500
\tolerance=3000
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=3em
% Figure/table numbering widths from verified CP114 List of Figures/Tables.
\renewcommand{\cftfigpresnum}{Fig.\ }
\setlength{\cftfignumwidth}{6.5em}
\renewcommand{\cfttabpresnum}{Table\ }
\setlength{\cfttabnumwidth}{6.5em}

% CP114 front-matter parity override: narrow, researcher-specific legacy list
% presentation. The shared PU engine continues to own geometry, font, body,
% chapter headings, and general format defaults. Ref: CP114 official 115p.
\renewcommand{\cftdotsep}{1.5}
