\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{saugat_compat}[2026/08/14 CP68 content compatibility only]
\RequirePackage{float}
\RequirePackage{placeins}
\RequirePackage{enumitem}
% CP111 natural-reflow list policy: prevent flushbottom-like vertical stretching.
\setlist[itemize]{topsep=0.35em,itemsep=0.2em,parsep=0pt,partopsep=0pt}
\setlist[enumerate]{topsep=0.35em,itemsep=0.2em,parsep=0pt,partopsep=0pt}
\RequirePackage{listings}
\RequirePackage{siunitx}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
% CP93 default float policy: avoid preventable paragraph-bottom white gaps.
% Explicit [H] remains available for figures/tables that have already passed visual QA.
\makeatletter
\def\fps@figure{!htbp}
\def\fps@table{!htbp}
\makeatother

\pgfplotsset{compat=1.18,compat/show suggested version=false}
\usepgfplotslibrary{groupplots}
\usetikzlibrary{positioning,arrows.meta}
\sisetup{inter-unit-product = \cdot}
\lstset{basicstyle=\scriptsize\ttfamily,breaklines=true,breakatwhitespace=false,columns=fullflexible,keepspaces=true,frame=single,numbers=left,numberstyle=\tiny,xleftmargin=1.5em,numbersep=0.5em,nolol=true}
% Compatibility aliases for preserved CP66 research source.
\newcommand{\myeq}[1]{\pueqref{#1}}
\newcommand{\myfig}[1]{\pufigref{#1}}
\newcommand{\mytab}[1]{\putabref{#1}}
\newcommand{\local}[1]{\textit{#1}}
