%% HYDROPOWER PHD — PROPOSED NORMALIZED INTEGRATION SCHEMA
%% Source boundary: only parameters explicitly named in the submitted Form E (22 Sep 2026)
%% and methodological/source support recorded in PHD_PROPOSAL_CITATION_LEARNING_MAP__CURRENT.
%% No numerical criterion weights or thresholds are invented here.
%% This is a conceptual research schema, not a claim that the production database is already implemented.

erDiagram
    STUDY_CASE {
        int case_id PK
        string case_name
        string case_type
        string location_note
        string access_class
    }

    SITE {
        int site_id PK
        int case_id FK
        string site_name
        string site_role
        string geometry_ref
        string access_class
    }

    ASSET {
        int asset_id PK
        int site_id FK
        string asset_name
        string asset_class
        string lifecycle_status
        string access_class
    }

    UNIT {
        int unit_id PK
        string unit_code
        string dimension
    }

    PARAMETER_DEFINITION {
        int parameter_id PK
        string parameter_code
        string parameter_name
        string domain
        int unit_id FK
    }

    REFERENCE_SOURCE {
        int reference_id PK
        string citation_key
        int publication_year
        string source_role
        string doi_or_authority
    }

    PARAMETER_SOURCE {
        int parameter_id FK
        int reference_id FK
        string support_role
    }

    DATA_SOURCE {
        int data_source_id PK
        int case_id FK
        string source_kind
        string stable_reference
        string access_class
        datetime registered_at
    }

    OBSERVATION {
        int observation_id PK
        int site_id FK
        int parameter_id FK
        int data_source_id FK
        datetime observed_at
        decimal value
    }

    SPATIAL_FEATURE {
        int feature_id PK
        int case_id FK
        int data_source_id FK
        string feature_type
        string geometry_ref
        datetime valid_at
    }

    SCREENING_CRITERION {
        int criterion_id PK
        int parameter_id FK
        string criterion_name
        string criterion_domain
        int reference_id FK
    }

    ANALYSIS_RUN {
        int run_id PK
        int case_id FK
        string run_kind
        string method_name
        datetime executed_at
        string status
    }

    RUN_INPUT {
        int run_id FK
        int data_source_id FK
        string input_role
    }

    RUN_CRITERION {
        int run_id FK
        int criterion_id FK
        decimal weight
        decimal threshold
    }

    SCREENING_RESULT {
        int run_id FK
        int site_id FK
        int criterion_id FK
        decimal criterion_value
        decimal score
        int evidence_source_id FK
    }

    ASSET_GEOMETRY {
        int asset_geometry_id PK
        int asset_id FK
        int data_source_id FK
        string geometry_ref
        string geometry_type
    }

    ASSET_MATERIAL {
        int material_record_id PK
        int asset_id FK
        int data_source_id FK
        string material_name
    }

    LOAD_ACTION {
        int load_action_id PK
        int asset_id FK
        int parameter_id FK
        int data_source_id FK
        decimal value
    }

    ANALYSIS_RESULT {
        int analysis_result_id PK
        int run_id FK
        int asset_id FK
        int parameter_id FK
        decimal value
        int evidence_source_id FK
    }

    INSPECTION_RECORD {
        int inspection_id PK
        int asset_id FK
        int data_source_id FK
        datetime inspected_at
        string condition_record
    }

    BIM_OBJECT {
        int bim_object_id PK
        int data_source_id FK
        string object_ref
        string object_type
    }

    ASSET_BIM_MAP {
        int asset_id FK
        int bim_object_id FK
        string mapping_status
        string limitation_note
    }

    ASSET_GIS_MAP {
        int asset_id FK
        int feature_id FK
        string mapping_status
        string limitation_note
    }

    VALIDATION_RECORD {
        int validation_id PK
        int case_id FK
        int run_id FK
        string validation_type
        string result_status
        int evidence_source_id FK
    }

    WEB_PRESENTATION {
        int web_item_id PK
        int case_id FK
        string presentation_type
        string access_class
        string metadata_ref
    }

    STUDY_CASE ||--o{ SITE : contains
    SITE ||--o{ ASSET : contains
    STUDY_CASE ||--o{ DATA_SOURCE : registers
    STUDY_CASE ||--o{ SPATIAL_FEATURE : contextualizes
    STUDY_CASE ||--o{ ANALYSIS_RUN : executes
    STUDY_CASE ||--o{ VALIDATION_RECORD : validates
    STUDY_CASE ||--o{ WEB_PRESENTATION : publishes

    UNIT ||--o{ PARAMETER_DEFINITION : standardizes
    PARAMETER_DEFINITION ||--o{ PARAMETER_SOURCE : supported_by
    REFERENCE_SOURCE ||--o{ PARAMETER_SOURCE : supports
    PARAMETER_DEFINITION ||--o{ OBSERVATION : types
    PARAMETER_DEFINITION ||--o{ SCREENING_CRITERION : defines
    PARAMETER_DEFINITION ||--o{ LOAD_ACTION : types
    PARAMETER_DEFINITION ||--o{ ANALYSIS_RESULT : types

    SITE ||--o{ OBSERVATION : records
    DATA_SOURCE ||--o{ OBSERVATION : provenance
    DATA_SOURCE ||--o{ SPATIAL_FEATURE : provenance
    DATA_SOURCE ||--o{ ASSET_GEOMETRY : provenance
    DATA_SOURCE ||--o{ ASSET_MATERIAL : provenance
    DATA_SOURCE ||--o{ LOAD_ACTION : provenance
    DATA_SOURCE ||--o{ INSPECTION_RECORD : provenance
    DATA_SOURCE ||--o{ BIM_OBJECT : provenance

    ANALYSIS_RUN ||--o{ RUN_INPUT : consumes
    DATA_SOURCE ||--o{ RUN_INPUT : supplies
    ANALYSIS_RUN ||--o{ RUN_CRITERION : configures
    SCREENING_CRITERION ||--o{ RUN_CRITERION : parameterizes
    ANALYSIS_RUN ||--o{ SCREENING_RESULT : produces
    SITE ||--o{ SCREENING_RESULT : evaluated_as
    SCREENING_CRITERION ||--o{ SCREENING_RESULT : scores
    DATA_SOURCE ||--o{ SCREENING_RESULT : evidence

    ASSET ||--o{ ASSET_GEOMETRY : has
    ASSET ||--o{ ASSET_MATERIAL : has
    ASSET ||--o{ LOAD_ACTION : has
    ASSET ||--o{ INSPECTION_RECORD : inspected_by
    ASSET ||--o{ ANALYSIS_RESULT : receives
    ANALYSIS_RUN ||--o{ ANALYSIS_RESULT : produces
    DATA_SOURCE ||--o{ ANALYSIS_RESULT : evidence

    ASSET ||--o{ ASSET_BIM_MAP : maps
    BIM_OBJECT ||--o{ ASSET_BIM_MAP : mapped_to
    ASSET ||--o{ ASSET_GIS_MAP : maps
    SPATIAL_FEATURE ||--o{ ASSET_GIS_MAP : mapped_to

    ANALYSIS_RUN ||--o{ VALIDATION_RECORD : checked_by
    DATA_SOURCE ||--o{ VALIDATION_RECORD : evidence
