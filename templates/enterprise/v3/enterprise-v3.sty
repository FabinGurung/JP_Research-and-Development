\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{enterprise-v3}[2026/10/12 Canonical Enterprise QA candidate]
\RequirePackage[a4paper,left=23mm,right=23mm,top=25mm,bottom=23mm,headheight=17pt,headsep=6mm,footskip=10mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern,microtype,parskip,xcolor,tabularx,array,booktabs,longtable,fancyhdr,lastpage,needspace}
\definecolor{EnterpriseInk}{HTML}{243C35}
\definecolor{EnterpriseAccent}{HTML}{A27A43}
\definecolor{EnterpriseMuted}{HTML}{56675F}
\definecolor{EnterprisePale}{HTML}{F0F4F1}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3.2pt}
\setlength{\tabcolsep}{5pt}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\textcolor{EnterpriseInk}{DOCUMENT FOR REVIEW}}
\fancyhead[R]{\footnotesize\textcolor{EnterpriseMuted}{NOT FOR SIGNATURE}}
\fancyfoot[L]{\footnotesize Example content is fictional}
\fancyfoot[R]{\footnotesize Page \thepage\ of \pageref{LastPage}}
\renewcommand{\headrulewidth}{0pt}
\newcommand{\EnterpriseHeading}[2]{%
{\centering{\color{EnterpriseMuted}\small ENTERPRISE DOCUMENTS}\par\vspace{3mm}%
{\color{EnterpriseInk}\bfseries\LARGE #1}\par\vspace{2mm}%
{\color{EnterpriseAccent}\rule{\linewidth}{1.25pt}}\par\vspace{1mm}%
{\small\color{EnterpriseMuted}#2}\par\vspace{3mm}}%
}
\newcommand{\EnterpriseMeta}[2]{\noindent\begin{tabularx}{\linewidth}{@{}>{\bfseries\color{EnterpriseInk}}p{40mm}X@{}}#1 & #2\end{tabularx}\par}
\newcommand{\EnterpriseSection}[1]{\par\Needspace{4\baselineskip}\vspace{3mm}{\bfseries\color{EnterpriseInk}\large #1}\par\vspace{-1mm}{\color{EnterpriseAccent}\rule{\linewidth}{.5pt}}\par\vspace{1mm}}
\newcommand{\EnterpriseField}[2]{\par\noindent{\color{EnterpriseInk}\bfseries #1}\par{\color{EnterpriseMuted}#2}\par\vspace{2mm}}
\newcommand{\EnterpriseWarning}[1]{\par\vspace{3mm}\noindent\fcolorbox{EnterpriseAccent}{EnterprisePale}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule}{\footnotesize #1}}\par}
\newcommand{\EnterpriseSignature}{\par\vspace{4mm}\noindent\begin{tabularx}{\linewidth}{@{}X@{\hspace{14mm}}X@{}}Prepared by: \rule{32mm}{.4pt}&Checked by: \rule{32mm}{.4pt}\\[3mm]Date: \rule{30mm}{.4pt}&Approved by: \rule{30mm}{.4pt}\end{tabularx}}
