{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "GITHUB",
        "GOOGLE_DRIVE"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "receipt_id",
    "event_id",
    "provider",
    "observed_at",
    "object_id",
    "revision",
    "result",
    "sha256"
  ],
  "additionalProperties": false
}
