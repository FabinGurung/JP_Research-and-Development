{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "parent_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "PRE",
        "SNAPSHOT",
        "DUPLICATE",
        "ENUMERATE",
        "ARCHIVE",
        "MUTATE",
        "HASH",
        "POST",
        "PROVIDER_READBACK",
        "ACK",
        "REGISTER",
        "TAG",
        "RELEASE",
        "SUPERSEDE",
        "ROLLBACK_POINTER",
        "DEBT_REGISTER",
        "CLOSE"
      ]
    },
    "pre_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "pre_snapshots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "post_snapshots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "source_authority": {
            "const": "GOOGLE_DRIVE"
          },
          "drive_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "visibility": {
            "enum": [
              "PUBLIC",
              "RESTRICTED"
            ]
          },
          "release": {
            "type": [
              "string",
              "null"
            ]
          },
          "reverse_reference_receipt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "artifact_id",
          "artifact_type",
          "source_authority",
          "drive_id",
          "sha256",
          "bytes",
          "visibility",
          "release",
          "reverse_reference_receipt"
        ],
        "additionalProperties": false
      }
    },
    "readback": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "receipt"
      ],
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "receipt"
      ],
      "additionalProperties": false
    },
    "ack": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "receipt"
      ],
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "receipt"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "CLOSED",
        "BLOCKED"
      ]
    },
    "open_debt": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "project_id",
    "project",
    "lane",
    "sequence",
    "parent_event",
    "timestamp",
    "actor",
    "tool",
    "operation",
    "pre_commit",
    "pre_snapshots",
    "post_snapshots",
    "artifacts",
    "readback",
    "qa",
    "ack",
    "registration",
    "release",
    "supersedes",
    "status",
    "open_debt",
    "next_boundary"
  ],
  "additionalProperties": false
}
