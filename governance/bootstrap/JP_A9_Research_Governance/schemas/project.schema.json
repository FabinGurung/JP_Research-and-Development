{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){2,}$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "scientific_authority": {
      "const": "GOOGLE_DRIVE"
    },
    "public_projection": {
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "slug",
    "label",
    "scientific_authority",
    "public_projection"
  ],
  "additionalProperties": false
}
