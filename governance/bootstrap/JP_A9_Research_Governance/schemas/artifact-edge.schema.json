    "edge_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "const": "GOVERNS_DRIVE_ARTIFACT"
    },
    "reverse_reference_receipt": {
      "type": [
