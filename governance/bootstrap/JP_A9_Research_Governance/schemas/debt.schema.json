{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "debt_id": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resolution_event": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "debt_id",
          "lane",
          "status",
          "description",
          "resolution_event"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project_id",
    "items"
  ],
  "additionalProperties": false
}
