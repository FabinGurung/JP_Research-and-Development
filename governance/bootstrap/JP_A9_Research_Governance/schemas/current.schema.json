{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "latest_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest_closed_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "UNVERIFIED",
        "OPEN",
        "CLOSED",
        "BLOCKED"
      ]
    },
    "open_debt": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "project",
    "lane",
    "sequence",
    "latest_event",
    "latest_closed_event",
    "status",
    "open_debt",
    "next_boundary"
  ],
  "additionalProperties": false
}
